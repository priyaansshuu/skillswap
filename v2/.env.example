# Copy to .env. Replace every placeholder before running.
DATABASE_URL=postgresql+psycopg://skillswap:replace-password@localhost:5432/skillswap
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-password
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
STARTER_MINUTES=120
REPUTATION_HALF_LIFE_DAYS=90
# Tests must use a separate disposable database, never the demo database.
TEST_DATABASE_URL=postgresql+psycopg://skillswap:replace-password@localhost:5432/skillswap_test
